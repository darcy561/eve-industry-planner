# Dockerignore for frontend build context
# This only applies when build context is set to ./frontend

# Node modules (installed fresh in container via cache mount)
node_modules/

# Build output (we build fresh in container)
dist/

# Test files
tests/
**/*.test.js
**/*.test.jsx
**/*.spec.js
**/*.spec.jsx

# Optional project-only files
cors.json

# Logs
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation
*.md
README*

