{
  "$comment": "Group derivation corpus. Both the SPA (Classes/group.js) and the backend (shared/groupshape) derive a group document from the jobs it holds, and both read these cases so a rule cannot change on one side alone. A member's linked ESI ids are read from its rows, so the cases carry the runs, orders and transactions themselves. Derivation only: merge, restore and archived-member membership are not shared logic.",
  "cases": [
    {
      "name": "every field a member contributes",
      "why": "A member adds its own itemID to both the type and material sets, each build material to the materials, and its three ESI id lists to the linked sets.",
      "jobs": [
        {
          "jobID": "job-out",
          "name": "Rifter",
          "itemID": 587,
          "parentJobs": [],
          "build": {
            "materials": [
              {
                "typeID": 34
              },
              {
                "typeID": 36
              }
            ],
            "costs": {
              "linkedJobs": [
                {
                  "job_id": 11,
                  "status": "delivered",
                  "cost": 0
                }
              ]
            },
            "sale": {
              "marketOrders": [
                {
                  "order_id": 22
                }
              ]
            }
          }
        },
        {
          "jobID": "job-mid",
          "name": "Tritanium",
          "itemID": 34,
          "parentJobs": [
            "job-out"
          ],
          "build": {
            "materials": [],
            "sale": {
              "transactions": [
                {
                  "transaction_id": 33
                }
              ]
            }
          }
        }
      ],
      "expected": {
        "groupName": "Rifter",
        "includedJobIDs": [
          "job-out",
          "job-mid"
        ],
        "includedTypeIDs": [
          34,
          587
        ],
        "materialIDs": [
          34,
          36,
          587
        ],
        "outputJobCount": 1,
        "linkedJobIDs": [
          11
        ],
        "linkedOrderIDs": [
          22
        ],
        "linkedTransIDs": [
          33
        ]
      }
    },
    {
      "name": "only a parentless job is an output",
      "why": "The output count counts outputs and the name is built from them, so an intermediate feeding another member must not be mistaken for one.",
      "jobs": [
        {
          "jobID": "job-out",
          "name": "Rifter",
          "itemID": 587,
          "parentJobs": [],
          "build": {
            "materials": []
          }
        },
        {
          "jobID": "job-a",
          "name": "Tritanium",
          "itemID": 34,
          "parentJobs": [
            "job-out"
          ],
          "build": {
            "materials": []
          }
        },
        {
          "jobID": "job-b",
          "name": "Pyerite",
          "itemID": 35,
          "parentJobs": [
            "job-out"
          ],
          "build": {
            "materials": []
          }
        }
      ],
      "expected": {
        "groupName": "Rifter",
        "includedJobIDs": [
          "job-out",
          "job-a",
          "job-b"
        ],
        "includedTypeIDs": [
          34,
          35,
          587
        ],
        "materialIDs": [
          34,
          35,
          587
        ],
        "outputJobCount": 1,
        "linkedJobIDs": [],
        "linkedOrderIDs": [],
        "linkedTransIDs": []
      }
    },
    {
      "name": "several outputs name the group in order",
      "why": "Names join in member order, not sorted, so the group reads the way the planner lists it.",
      "jobs": [
        {
          "jobID": "job-1",
          "name": "Rifter",
          "itemID": 587,
          "parentJobs": [],
          "build": {
            "materials": []
          }
        },
        {
          "jobID": "job-2",
          "name": "Punisher",
          "itemID": 597,
          "parentJobs": [],
          "build": {
            "materials": []
          }
        }
      ],
      "expected": {
        "groupName": "Rifter, Punisher",
        "includedJobIDs": [
          "job-1",
          "job-2"
        ],
        "includedTypeIDs": [
          587,
          597
        ],
        "materialIDs": [
          587,
          597
        ],
        "outputJobCount": 2,
        "linkedJobIDs": [],
        "linkedOrderIDs": [],
        "linkedTransIDs": []
      }
    },
    {
      "name": "ids are sorted and deduplicated",
      "why": "Two members sharing a type contribute it once, and the arrays come back sorted so an unchanged group is not rewritten as modified.",
      "jobs": [
        {
          "jobID": "job-1",
          "name": "Rifter",
          "itemID": 587,
          "parentJobs": [],
          "build": {
            "materials": [
              {
                "typeID": 36
              },
              {
                "typeID": 34
              }
            ],
            "sale": {
              "marketOrders": [
                {
                  "order_id": 99
                },
                {
                  "order_id": 22
                }
              ]
            }
          }
        },
        {
          "jobID": "job-2",
          "name": "Rifter",
          "itemID": 587,
          "parentJobs": [],
          "build": {
            "materials": [
              {
                "typeID": 34
              }
            ],
            "sale": {
              "marketOrders": [
                {
                  "order_id": 22
                },
                {
                  "order_id": 11
                }
              ]
            }
          }
        }
      ],
      "expected": {
        "groupName": "Rifter, Rifter",
        "includedJobIDs": [
          "job-1",
          "job-2"
        ],
        "includedTypeIDs": [
          587
        ],
        "materialIDs": [
          34,
          36,
          587
        ],
        "outputJobCount": 2,
        "linkedJobIDs": [],
        "linkedOrderIDs": [
          11,
          22,
          99
        ],
        "linkedTransIDs": []
      }
    },
    {
      "name": "a blank name contributes nothing to the group name",
      "why": "An unnamed output is still an output and still counted, but it must not leave an empty segment in the name.",
