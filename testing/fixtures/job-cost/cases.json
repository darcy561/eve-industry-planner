{
  "$comment": "Job cost corpus. The SPA (Classes/job.js) and the backend (models.Job.CostParts) both work out what a job cost, and both read these cases so the two cannot drift. Sale lines keep ESI's own field names (`tax`); our own aggregate is a transaction fee. What a job produces is summed from its setups, materials from the purchases, installs from the linked ESI jobs extras from the extras rows and invention from its entries: build.costs.totalPurchaseCost is a cached copy that has historically been written both with and without invention.",
  "cases": [
    {
      "name": "every component",
      "why": "A job's cost is materials, install, extras, invention, broker fees and tax. Install is summed from the linked ESI jobs.",
      "job": {
        "jobID": "job-every-component",
        "itemID": 587,
        "jobType": 1,
        "build": {
          "materials": [
            {
              "typeID": 34,
              "purchasedCost": 60
            },
            {
              "typeID": 35,
              "purchasedCost": 40
            }
          ],
          "costs": {
            "totalPurchaseCost": 100,
            "linkedJobs": [
              {
                "job_id": 900000,
                "status": "delivered",
                "cost": 5
              }
            ],
            "extrasCosts": [
              {
                "id": "extra-1",
                "category": "0",
                "extraText": "Courier",
                "extraValue": 3
              }
            ],
            "inventionEntries": [
              {
                "id": 1,
                "itemName": "Datacore",
                "itemCost": 2
              }
            ]
          },
          "sale": {
            "brokersFee": [
              {
                "id": 0,
                "amount": 1.5
              }
            ],
            "transactions": [
              {
                "transaction_id": 0,
                "tax": 0.5
              },
              {
                "transaction_id": 1,
                "tax": 0.25
              }
            ]
          },
          "setup": {
            "setup-1": {
              "id": "setup-1",
              "runCount": 1,
              "jobCount": 1
            }
          }
        },
        "itemsProducedPerRun": 10
      },
      "expected": {
        "produced": 10,
        "materials": 100,
        "install": 5,
        "invention": 2,
        "extras": 3,
        "brokersFee": 1.5,
        "transactionFee": 0.75,
        "build": 110,
        "total": 112.25
      }
    },
    {
      "name": "materials come from the purchases",
      "why": "Materials are summed from each purchase, not read from the cached total.",
      "job": {
        "jobID": "job-materials-come-from-the-purchases",
        "itemID": 587,
        "jobType": 1,
        "build": {
          "materials": [
            {
              "typeID": 34,
              "purchasedCost": 10
            },
            {
              "typeID": 35,
              "purchasedCost": 20
            },
            {
              "typeID": 36,
              "purchasedCost": 30
            }
          ],
          "costs": {
            "totalPurchaseCost": 60
          },
          "sale": {
            "brokersFee": [],
            "transactions": []
          },
          "setup": {
            "setup-1": {
              "id": "setup-1",
              "runCount": 1,
              "jobCount": 1
            }
          }
        },
        "itemsProducedPerRun": 10
      },
      "expected": {
        "produced": 10,
        "materials": 60,
        "install": 0,
        "invention": 0,
        "extras": 0,
        "brokersFee": 0,
        "transactionFee": 0,
        "build": 60,
        "total": 60
      }
    },
    {
      "name": "cached total is ignored when it disagrees",
      "why": "totalPurchaseCost has been written both as materials alone and with invention folded in, so it is not the figure to trust.",
      "job": {
        "jobID": "job-cached-total-is-ignored-when-it-disagrees",
        "itemID": 587,
        "jobType": 1,
        "build": {
          "materials": [
            {
              "typeID": 34,
              "purchasedCost": 100
