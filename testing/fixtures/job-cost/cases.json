    {
      "name": "every component",
      "why": "A job's cost is materials, install, extras, invention, broker fees and tax. Install is summed from the linked ESI jobs.",
      "job": {
        "jobID": "job-every-component",
        "itemID": 587,
        "jobType": 1,
        "build": {
          "materials": {
            "34": {
              "typeID": 34,
              "purchasing": {
                "purchase-1": {
                  "id": "purchase-1",
                  "itemCount": 60,
                  "itemCost": 1,
                  "childJobImport": false
                }
              }
            },
            "35": {
              "typeID": 35,
              "purchasing": {
                "purchase-2": {
                  "id": "purchase-2",
                  "itemCount": 40,
                  "itemCost": 1,
                  "childJobImport": false
                }
              }
            }
          },
          "costs": {
            "extrasCosts": {
              "extra-1": {
                "id": "extra-1",
                "category": "0",
                "extraText": "Courier",
                "extraValue": 3
              }
            },
            "inventionEntries": {
              "1": {
                "id": 1,
                "itemName": "Datacore",
                "itemCost": 2
              }
            }
          },
          "sale": {},
          "setup": {
            "setup-1": {
              "id": "setup-1",
              "runCount": 1,
              "jobCount": 1,
              "materialCount": {
                "34": {
                  "typeID": 34,
                  "quantity": 60
                },
                "35": {
                  "typeID": 35,
                  "quantity": 40
                }
              }
            }
          }
        },
        "itemsProducedPerRun": 10,
        "esi": {
          "linkedJobs": {
            "900000": {
              "job_id": 900000,
              "status": "delivered",
              "cost": 5
            }
          },
          "marketOrders": {
            "900": {
              "order_id": 900,
              "fee": 1.5
            }
          },
          "transactions": {
            "0": {
              "transaction_id": 0,
              "tax": 0.5
            },
            "1": {
              "transaction_id": 1,
              "tax": 0.25
            }
          }
        }
      },
      "expected": {
        "produced": 10,
        "materials": 100,
        "install": 5,
        "invention": 2,
        "extras": 3,
        "brokersFee": 1.5,
        "transactionFee": 0.75,
        "build": 110,
        "total": 112.25
      }
