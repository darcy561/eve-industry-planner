        "jobID": "job-every-component",
        "itemID": 587,
        "jobType": 1,
        "build": {
          "materials": [
            {
              "typeID": 34,
              "purchasing": [
                {
                  "id": "purchase-1",
                  "typeID": 34,
                  "itemCount": 60,
                  "itemCost": 1,
                  "childJobImport": false
                }
              ]
            },
            {
              "typeID": 35,
              "purchasing": [
                {
                  "id": "purchase-2",
                  "typeID": 35,
                  "itemCount": 40,
                  "itemCost": 1,
                  "childJobImport": false
                }
              ]
            }
          ],
          "costs": {
