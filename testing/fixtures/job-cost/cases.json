              {
                "transaction_id": 1,
                "tax": 0.25
              }
            ]
          },
          "setup": {
            "setup-1": {
              "id": "setup-1",
              "runCount": 1,
              "jobCount": 1,
              "materialCount": {
                "34": {
                  "typeID": 34,
                  "quantity": 60
                },
                "35": {
                  "typeID": 35,
                  "quantity": 40
                }
              }
            }
