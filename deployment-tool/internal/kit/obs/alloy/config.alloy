// Docker logs → Loki for non-Go Swarm tasks (frontend/nginx, edge, data, obs infra).
// The six Go services use OTLP below — dropped from the docker scrape.
// Docker API via allowlisted alloy-docker-proxy (eip-docker-alloy only).
//
// #15: Swarm com.docker.swarm.service.name → compose_service (strip eip_ prefix) for LogQL.
discovery.docker "docker" {
	host             = "tcp://alloy-docker-proxy:2375"
	refresh_interval = "5s"

	filter {
		name   = "status"
		values = ["created", "restarting", "running"]
	}
}

discovery.relabel "docker" {
	targets = discovery.docker.docker.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		regex         = "(.+)"
		target_label  = "swarm_service"
	}

	// STACK_NAME=eip → eip_<role>
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		regex         = "eip_(.+)"
		target_label  = "compose_service"
		replacement   = "$1"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		regex         = "([^_]+)_.+"
		target_label  = "swarm_stack"
		replacement   = "$1"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_task_name"]
		regex         = "[^.]+\\.([0-9]+)\\..+"
		target_label  = "task_slot"
		replacement   = "$1"
	}

	// Every Go service exports its logs over OTLP, so scraping their stdout as well would file
	// each line twice under two label sets whenever the stdout mirror is on.
	rule {
		source_labels = ["compose_service"]
		regex         = "(api|core|worker|websocket|ws-router|capacity-controller)"
		action        = "drop"
	}

	rule {
		source_labels = ["compose_service"]
		regex         = "(alloy|alloy-docker-proxy|traefik-docker-proxy|ws-docker-proxy)"
		action        = "drop"
	}
}

loki.source.docker "docker" {
	host             = "tcp://alloy-docker-proxy:2375"
	targets          = discovery.docker.docker.targets
	relabel_rules    = discovery.relabel.docker.rules
	refresh_interval = "5s"
	forward_to       = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
	external_labels = {}
}

// OTLP from Go services (replaces otel-collector).
otelcol.receiver.otlp "apps" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		metrics = [otelcol.processor.batch.apps.input]
		logs    = [otelcol.processor.transform.scrub_otlp_boilerplate.input]
		traces  = [otelcol.processor.batch.traces.input]
	}
}

// Drop OTel/zap boilerplate from access logs before Loki (scope, SDK, caller metadata).
otelcol.processor.transform "scrub_otlp_boilerplate" {
	error_mode = "ignore"

	log_statements {
		context = "log"
		statements = [
			`set(flags, 0)`,
			`delete_key(attributes, "code.filepath")`,
			`delete_key(attributes, "code.function")`,
			`delete_key(attributes, "code.lineno")`,
			`delete_key(attributes, "code.file.path")`,
			`delete_key(attributes, "code.function.name")`,
			`delete_key(attributes, "code.line.number")`,
		]
	}

	log_statements {
		context = "resource"
		statements = [
			`delete_key(attributes, "telemetry.sdk.language")`,
			`delete_key(attributes, "telemetry.sdk.name")`,
			`delete_key(attributes, "telemetry.sdk.version")`,
			`delete_key(attributes, "host.name")`,
		]
	}

	log_statements {
		context = "scope"
		statements = [
			`set(name, "")`,
		]
	}

	output {
		logs = [otelcol.processor.batch.logs.input]
	}
}

otelcol.processor.batch "apps" {
	output {
		metrics = [otelcol.exporter.prometheus.apps.input]
	}
}

// Accept OTLP logs (Go services) → Loki native OTLP (/otlp). Log line = message; zap fields = structured metadata.
otelcol.processor.batch "logs" {
	output {
		logs = [otelcol.exporter.otlphttp.loki.input]
	}
}

otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = "http://loki:3100/otlp"
		tls {
			insecure = true
		}
	}
}

// Accept OTLP traces then discard — app traces go to Sentry, not Alloy.
otelcol.processor.batch "traces" {
	output {
		traces = [otelcol.exporter.debug.discard_traces.input]
	}
}

otelcol.exporter.debug "discard_traces" {
	verbosity           = "basic"
	sampling_initial    = 0
	sampling_thereafter = 0
}

// Match otel-collector translation_strategy UnderscoreEscapingWithoutSuffixes (no extra type/unit suffixes).
// resource_to_telemetry_conversion promotes OTel resource attrs (service.name, service.instance.id)
// onto metric labels (service_name, service_instance_id) — standard per-container identity for Prom/Grafana.
otelcol.exporter.prometheus "apps" {
	add_metric_suffixes              = false
	include_scope_info               = false
	include_target_info              = false
	include_scope_labels             = false
	resource_to_telemetry_conversion = true
	forward_to                       = [prometheus.relabel.otel_collector.receiver]
}

// Prometheus scrape used job="otel_collector"; preserve that label for dashboards that filter on it.
// Traefik pushes OTLP down this same path, so the second rule takes it back out of that bucket —
// rules apply in order, and it would otherwise lose its identity to the stamp above.
prometheus.relabel "otel_collector" {
	forward_to = [prometheus.remote_write.local.receiver]

	rule {
		action       = "replace"
		target_label = "job"
		replacement  = "otel_collector"
	}

	rule {
		action        = "replace"
		source_labels = ["service_name"]
		regex         = "traefik"
		target_label  = "job"
		replacement   = "traefik"
	}
}

// Embedded redis_exporter. Scraped straight into remote_write: the otel_collector relabel below
// stamps job=otel_collector on everything crossing it, which would erase job="redis".
prometheus.exporter.redis "redis" {
	redis_addr     = "redis://redis:6379"
	redis_password = sys.env("REDIS_PASSWORD")
}

// The exporter's targets carry job="integrations/redis"; target labels beat the scrape's job_name,
// so the rewrite has to happen here or the Redis dashboard's job="redis" filter matches nothing.
discovery.relabel "redis" {
	targets = prometheus.exporter.redis.redis.targets

	rule {
		action       = "replace"
		target_label = "job"
		replacement  = "redis"
	}
}

prometheus.scrape "redis" {
	targets         = discovery.relabel.redis.output
	forward_to      = [prometheus.remote_write.local.receiver]
	scrape_interval = "15s"
}

// Embedded node_exporter. Alloy runs in a container, so the collectors are pointed at the host's
// procfs and sysfs through the read-only rootfs bind rather than the container's own.
prometheus.exporter.unix "host" {
	rootfs_path        = "/host"
	procfs_path        = "/host/proc"
	sysfs_path         = "/host/sys"
	disable_collectors = ["kernel_hung"]
}

discovery.relabel "node" {
	targets = prometheus.exporter.unix.host.targets

	rule {
		action       = "replace"
		target_label = "job"
		replacement  = "node"
	}
}

prometheus.scrape "node" {
	targets         = discovery.relabel.node.output
	forward_to      = [prometheus.remote_write.local.receiver]
	scrape_interval = "15s"
}

// Embedded mongodb_exporter. collect_all, compatible_mode and direct_connect already default to
// what the standalone exporter was run with, so only the URI is set here.
//
// The URI is the component's only way to take credentials, and it is safe to interpolate them
// unescaped only because EnvFields generates and validates FieldPassword against the url-safe
// base64 alphabet (A-Z a-z 0-9 _ -). Widening that alphabet would need percent-encoding here.
prometheus.exporter.mongodb "mongo" {
	mongodb_uri = "mongodb://" + sys.env("MONGO_ROOT_USERNAME") + ":" + sys.env("MONGO_ROOT_PASSWORD") + "@mongo:27017/admin?authSource=admin&replicaSet=rs0"
}

discovery.relabel "mongodb" {
	targets = prometheus.exporter.mongodb.mongo.targets

	rule {
		action       = "replace"
		target_label = "job"
		replacement  = "mongodb"
	}
}

prometheus.scrape "mongodb" {
	targets         = discovery.relabel.mongodb.output
	forward_to      = [prometheus.remote_write.local.receiver]
	scrape_interval = "15s"
}

// nats-exporter stays a container: Alloy has no NATS exporter component, so this is a scrape
// rather than an embed. Static target because the exporter is a fixed service alias on eip-obs.
prometheus.scrape "nats" {
	targets         = [{ __address__ = "nats-exporter:7777" }]
	forward_to      = [prometheus.remote_write.local.receiver]
	job_name        = "nats"
	scrape_interval = "15s"
}

// asynqmon publishes Prometheus exposition and nothing else, so it is scraped rather than embedded.
// Every panel on the Asynq dashboard filters job="asynqmon".
prometheus.scrape "asynqmon" {
	targets         = [{ __address__ = "asynqmon:8080" }]
	forward_to      = [prometheus.remote_write.local.receiver]
	job_name        = "asynqmon"
	scrape_interval = "15s"
}

// SeaweedFS exposes master, filer, volume server and admin metrics on one port under `mini`; the
// separate -s3.metricsPort does not listen in that mode, so there is nothing else to scrape.
prometheus.scrape "seaweedfs" {
	targets         = [{ __address__ = "seaweedfs:9327" }]
	forward_to      = [prometheus.remote_write.local.receiver]
	job_name        = "seaweedfs"
	scrape_interval = "15s"
}

prometheus.remote_write "local" {
	endpoint {
		url = "http://prometheus:9090/api/v1/write"
	}
}
