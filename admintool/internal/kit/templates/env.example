# ============================================
# Release version (required, non-secret)
# Image tags (GHCR / local bake), Redis advertise, task APP_VERSION.
# ============================================
APP_VERSION=0.8.15

# ============================================
# Frontend / SPA (public knobs + SSO)
# ============================================

# Google Analytics 4 web stream Measurement ID (`G-…`). Omit to disable collection.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# EVE Online SSO
# EVE_CLIENT_ID / CALLBACK / SCOPE are public (SPA + API). EVE_CLIENT_SECRET is private (API).
EVE_CLIENT_ID=your_eve_oauth_client_id
EVE_CLIENT_SECRET=your_eve_oauth_client_secret
EVE_CALLBACK_URL=https://your-domain.com/auth/callback
EVE_SCOPE=esi-characters.read_blueprints.v1 esi-industry.read_character_jobs.v1 esi-assets.read_assets.v1

# ============================================
# MongoDB
# ============================================

# Root admin (mongo-setup / container bootstrap).
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=auto-generate-me

# Shared app DB user (api / worker / core / websocket when *_API unset).
MONGO_USERNAME=EXAMPLE_USERNAME
MONGO_PASSWORD=auto-generate-me

# Optional API-only Mongo user. Empty → api uses MONGO_USERNAME / MONGO_PASSWORD.
# When both set, api uses mongo.ConnectAPI. Create the DB user before enabling.
# MONGO_USERNAME_API=
# MONGO_PASSWORD_API=

# ============================================
# Redis
# ============================================

# Shared password (all consumers when *_API unset).
# Compose treats `$` as substitution — double a literal `$` (e.g. ab$cd → ab$$cd).
# Auto-generated values avoid `$`.
REDIS_PASSWORD=auto-generate-me

# Optional API-only Redis ACL user. Empty → api uses REDIS_PASSWORD.
# When REDIS_PASSWORD_API is set, api uses redis.ConnectAPI. Create the ACL user before enabling.
# REDIS_USERNAME_API=
# REDIS_PASSWORD_API=

# ============================================
# Object store (SeaweedFS S3)
# ============================================

# S3-compatible credentials for the static-data / static-data-test buckets (objectstore / SDE).
S3_ACCESS_KEY=eipobject
S3_SECRET_KEY=auto-generate-me

# ============================================
# Auth / tokens
# ============================================

# HMAC secret for deterministic authz refs (character / corp / alliance). Keep stable per environment.
# `auto-generate-me` is replaced on first ensure-env.
AUTHZ_HMAC_KEY=auto-generate-me

# AES-256-GCM key for cloud refresh tokens at rest. `auto-generate-me` replaced on first ensure-env.
REFRESH_TOKEN_AES_KEY=auto-generate-me

# Active keyring version for refresh-token encryption (default v1).
REFRESH_TOKEN_AES_KEY_VERSION=v1

# Optional legacy key map: JSON version → base64 key (same length as REFRESH_TOKEN_AES_KEY).
# Example: {"v1":"base64-old-key","v0":"base64-older-key"}
# REFRESH_TOKEN_AES_LEGACY_KEYS={}

# ============================================
# Runtime / feature flags
# ============================================

# Alloy → Loki ingest floor for Go OTLP logs: debug | info | warn | error (case-insensitive).
# Go apps still emit debug; Alloy drops below this level.
LOG_LEVEL=info

# Stdout mirror of structured logs (docker logs).
# Unset + ENVIRONMENT=development|dev|local → on. Explicit: LOG_STDOUT=true|false.
# LOG_STDOUT=false

# ENVIRONMENT: SPA bake mode, Go Sentry environment tag, default LOG_STDOUT when unset.
# DEPLOYMENT_ENVIRONMENT (if set) wins over ENVIRONMENT for Go.
# CI Public images bake ENVIRONMENT=production.
# ENVIRONMENT=development

# API maintenance mode when true-ish (1, true, yes, on). Missing/empty → false.
# MAINTENANCE_MODE=false

# ============================================
# Optional integrations
# ============================================

# Discord webhook for feedback API. Unset → API succeeds but skips Discord.
# FEEDBACK_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Sentry (optional). Same names for Go services and SPA bake.
# SENTRY_TRACES_SAMPLE_RATE (0.0–1.0): Go performance + SPA tracesSampleRate. Empty → 0.
# SENTRY_ERROR_SAMPLE_RATE (0.0–1.0): SPA error sampleRate only. Empty → 1.
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_ERROR_SAMPLE_RATE=0.5
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT_ID=your-project-slug
# SENTRY_AUTH_TOKEN=...   # optional; SPA source-map upload during frontend image build

# ============================================
# Observability (Grafana Compose service)
# ============================================

# Grafana login. `auto-generate-me` replaced on first ensure-env.
# GRAFANA_ROOT_URL should match how you open Grafana (e.g. http://127.0.0.1/grafana/).
# Compose: use $$ for a literal $ in the password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=auto-generate-me
# GRAFANA_ROOT_URL=http://127.0.0.1/grafana/
