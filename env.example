# ============================================
# Frontend Configuration
# ============================================

# Firebase Configuration
FIREBASE_API_KEY=AIzaSyExample1234567890abcdefghijklmnopqrstuvwxyz
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_VAPID_KEY=BGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
API_URL=http://api:80

# ReCaptcha Configuration
RECAPTCHA_KEY=6LdXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# EVE Online SSO Configuration
EVE_CLIENT_ID=your_eve_oauth_client_id
EVE_CLIENT_SECRET=your_eve_oauth_client_secret
EVE_CALLBACK_URL=https://your-domain.com/auth/callback
EVE_SCOPE=esi-characters.read_blueprints.v1 esi-industry.read_character_jobs.v1 esi-assets.read_assets.v1

# ============================================
# Backend Configuration (Go Services)
# ============================================

# MongoDB Root User Configuration (REQUIRED for MongoDB authentication)
# These are used to create the root admin user in MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-this-root-password

# MongoDB Primary Database Configuration (REQUIRED)
MONGO_USERNAME=EXAMPLE_USERNAME
MONGO_PASSWORD=EXAMPLE_USERNAME

# MongoDB Primary Connection Details (Optional - used to build primary MongoDB connection URL)
# These are used independently to generate the primary MongoDB connection URL
# MONGO_HOST=mongo
# MONGO_PORT=27017

# MongoDB Secondary Connection Details (Optional - used to build secondary MongoDB connection URL)
# These are used independently to generate the secondary MongoDB connection URL
# MONGO_SECONDARY_HOST=mongo-secondary
# MONGO_SECONDARY_PORT=27017

# Redis Configuration (REQUIRED)
REDIS_PASSWORD=change-this-redis-password

# Service URLs (Optional - defaults are hardcoded)
# REDIS_HOST=redis
# REDIS_PORT=6379
# NATS_URL=nats://nats:4222
# MINIO_URL=http://minio:9000

# Service Ports (Optional - defaults are hardcoded)
# API_PORT=4000
# WS_PORT=4001

# Log Level Configuration
# Valid values: debug, warn/warning, error, info (default)
# Case-insensitive
LOG_LEVEL=info

# Auth Configuration
AUTH_SECRET=your-super-secret-auth-key-change-this-in-production
JWT_PRIVATE_KEY_ENV_VAR=JWT_PRIVATE_KEY
JWT_KEY_ID=default-key-id
EXTERNAL_JWT_SECRET=your-external-jwt-secret
EXTERNAL_JWT_ISSUER=your-jwt-issuer
EXTERNAL_JWT_AUDIENCE=your-jwt-audience


# Feedback Configuration (Optional)
# Discord webhook URL for feedback notifications
# If not set, reverts back to using the default url in the container.
# If the container is being built manually then this needs to be included or feedback messages will not be recieved.
# FEEDBACK_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Environment (Optional)
# Controls the build environment for the frontend (development or production)
# - "development": Builds with development optimizations and debugging enabled
# - "production": Builds with production optimizations (minified, tree-shaken, etc.)
# If not present in .env file, defaults to "production"
# In GitHub Actions: automatically set to "development" for "migration" branch, "production" for "Live" branch
# Uncomment and set if you need a different environment:
# ENVIRONMENT=production