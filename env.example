# ============================================
# Release version (required)
# ============================================
# Semver X.Y.Z — used for:
#   - ghcr.io/... image tags (docker-compose.yml)
#   - Docker/Vite build args (docker-compose.dev.yml, Dockerfiles)
#   - GitHub container images: manual "Publish Public containers" workflow (Public branch only); set `app_version` there (same value as here). If that version already exists on ghcr.io, enable "Confirm overwrite" when re-running.
# No fallback in compose or frontend build — this must be set.
APP_VERSION=0.8.15

# ============================================
# Frontend Configuration
# ============================================

# Google Analytics 4 (optional). Web stream Measurement ID (`G-…`). Omit to disable gtag / page-view collection.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# EVE Online SSO Configuration
EVE_CLIENT_ID=your_eve_oauth_client_id
EVE_CLIENT_SECRET=your_eve_oauth_client_secret
EVE_CALLBACK_URL=https://your-domain.com/auth/callback
EVE_SCOPE=esi-characters.read_blueprints.v1 esi-industry.read_character_jobs.v1 esi-assets.read_assets.v1

# ============================================
# Backend Configuration (Go Services)
# ============================================

# MongoDB Root User Configuration (REQUIRED for MongoDB authentication)
# These are used to create the root admin user in MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=auto-generate-me

# MongoDB Primary Database Configuration (REQUIRED)
MONGO_USERNAME=EXAMPLE_USERNAME
MONGO_PASSWORD=auto-generate-me

# MongoDB Primary Connection Details (Optional - used to build primary MongoDB connection URL)
# These are used independently to generate the primary MongoDB connection URL
# MONGO_HOST=mongo
# MONGO_PORT=27017

# MongoDB replica set name (Optional)
# Single-node deployments should keep this as rs0 unless you deliberately change it.
# MONGO_REPLICA_SET=rs0

# GOOGLE_APPLICATION_CREDENTIALS should point to the path of the service account JSON
# inside the Go service containers. In docker-compose, mount the JSON and set this path.
# Example: /app/adminSDK.json (when mounted as a volume in docker-compose.yml)
GOOGLE_APPLICATION_CREDENTIALS=/app/adminSDK.json

# Redis Configuration (REQUIRED)
REDIS_PASSWORD=auto-generate-me
# Docker Compose treats $ as variable substitution. Auto-generated secrets here avoid $, so no escaping is needed.
# If you manually set a password with a literal $, double it (e.g. ab$cd -> ab$$cd).

# Service URLs (Optional - defaults are hardcoded)
# REDIS_HOST=redis
# REDIS_PORT=6379
# NATS_URL=nats://nats:4222

# Service Ports (Optional - defaults are hardcoded)
# API_PORT=4000
# WS_PORT=4001

# Log Level (Alloy → Loki ingest for Go OTLP logs)
# Valid values: debug, info, warn/warning, error (case-insensitive)
# Go services always export debug; Alloy drops below this level before Loki. Change + restart alloy only:
#   docker compose restart alloy
LOG_LEVEL=info

# Structured logs: Go services export OTLP logs to Alloy → Loki (log line = message; fields = structured metadata).
# Grafana dashboards filter on compose_service (from telemetry.Init), severity, and field names (method, path, task_type, …).
# Set LOG_STDOUT=true to also mirror JSON logs to container stdout (docker compose logs).
# LOG_STDOUT=false

# Sentry (optional). Bake from root `.env` before `npm run build` or frontend Docker build; same names in CI.
# `SENTRY_TRACES_SAMPLE_RATE` (0.0–1.0): one variable for Go performance (api, worker, core, websocket) AND the SPA `tracesSampleRate`. Empty → 0.
# `SENTRY_ERROR_SAMPLE_RATE` (0.0–1.0): SPA error `sampleRate` only (not Go). Empty → 1. User feedback (`captureFeedback`) is separate from both.
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_ERROR_SAMPLE_RATE=0.5
#
# Local `make dev` (docker-compose.dev.yml): optional build-time bake — set in .env then rebuild (`make dev` / compose --build).
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT_ID=your-project-slug
# SENTRY_AUTH_TOKEN=...   # optional; Vite plugin uses for release/source map upload during frontend image build

# Auth Configuration
# Internal authz HMAC secret used to derive deterministic refs for character/corp/alliance IDs.
# Keep this secret private and stable per environment. During bootstrap, Makefile auto-generates
# this value when creating .env from env.example.
AUTHZ_HMAC_KEY=auto-generate-me
# AES-256-GCM key for encrypting persisted cloud refresh tokens at rest.
# During bootstrap, Makefile auto-generates this value when creating/updating .env.
REFRESH_TOKEN_AES_KEY=auto-generate-me
# Active key version for refresh-token encryption keyring (defaults to v1 if omitted).
REFRESH_TOKEN_AES_KEY_VERSION=v1
# Optional legacy key map for decrypting rows encrypted with older versions.
# JSON object of version -> base64 key, with key length matching REFRESH_TOKEN_AES_KEY.
# Example: {"v1":"base64-old-key","v0":"base64-older-key"}
# REFRESH_TOKEN_AES_LEGACY_KEYS={}

# Feedback Configuration (Optional)
# Discord webhook URL for feedback notifications (API). For `make dev`, docker-compose.dev.yml passes this as a build-arg
# (baked FEEDBACK_DISCORD_WEBHOOK_URL in the image); you can still override at container runtime via this .env entry.
# If unset, the feedback API succeeds but skips posting to Discord.
# FEEDBACK_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Maintenance Mode (Optional)
# Enables API maintenance mode when true-ish (1, true, yes, on).
# If missing or empty, maintenance mode defaults to false.
# MAINTENANCE_MODE=false

# Environment (Optional)
# Controls the build environment for the frontend (development or production)
# - "development": Builds with development optimizations and debugging enabled
# - "production": Builds with production optimizations (minified, tree-shaken, etc.)
# If not present in .env file, defaults to "production"
# CI images from the Public branch workflow are always built with ENVIRONMENT=production.
# Uncomment and set if you need a different environment:
# ENVIRONMENT=production

# ============================================
# Observability (Grafana — docker-compose.yml)
# ============================================
# Used by the grafana service in docker-compose.yml. Production default bind: 10.8.0.1:3030 (VPN/internal).
# Local dev (`make dev`): set GRAFANA_HOST_PORT=3030 and GRAFANA_ROOT_URL=http://127.0.0.1:3030 in .env.
# `ensure-env.sh` replaces `auto-generate-me` with a random password when creating `.env` (same as DB/redis secrets).
# Change GRAFANA_ADMIN_* after bootstrap if you need a known password. On a reachable network, use a strong value.
# Docker Compose: use $$ for a literal $ in this password (same as Redis/Mongo above).

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=auto-generate-me