          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum by (task_type) (count_over_time({compose_service=\"worker\"} |= \"asynq task failed\" | json | task_type != \"\" [$__interval]))",
          "legendFormat": "{{task_type}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Task type totals (failures from logs)",
      "type": "timeseries"
