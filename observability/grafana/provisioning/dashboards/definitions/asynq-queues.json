            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "decimals": 3,
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed % of processed" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 35 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["mean", "lastNotNull"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(asynq_tasks_failed_total{job=\"asynqmon\"}[$__rate_interval]))",
          "legendFormat": "failed (all queues)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(asynq_tasks_processed_total{job=\"asynqmon\"}[$__rate_interval]))",
          "legendFormat": "processed (all queues)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(asynq_tasks_failed_total{job=\"asynqmon\"}[$__rate_interval])) / clamp_min(sum(rate(asynq_tasks_processed_total{job=\"asynqmon\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "failed % of processed",
          "refId": "C"
        }
      ],
      "title": "Combined · queue errors & throughput",
      "type": "timeseries"
