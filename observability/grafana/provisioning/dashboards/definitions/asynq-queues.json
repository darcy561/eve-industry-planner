    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Queue-level throughput and failure rate from Redis (`asynqmon`). Failed % = failed / processed when processed &gt; 0.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
