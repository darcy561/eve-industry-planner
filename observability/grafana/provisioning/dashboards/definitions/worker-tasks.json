          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(worker_asynq_task_duration_milliseconds_sum{job=\"otel_collector\", outcome=\"success\"}[$__rate_interval])) by (task_type) / sum(rate(worker_asynq_task_duration_milliseconds_count{job=\"otel_collector\", outcome=\"success\"}[$__rate_interval])) by (task_type)",
