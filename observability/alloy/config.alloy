// Docker logs → Loki for non-Go services (frontend/nginx, infra). Go apps log via OTLP below.
discovery.docker "docker" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

discovery.relabel "docker" {
	targets = discovery.docker.docker.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}
}

loki.source.docker "docker" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.docker.docker.targets
	relabel_rules    = discovery.relabel.docker.rules
	refresh_interval = "5s"
	forward_to       = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
	external_labels = {}
}

// OTLP from Go services (replaces otel-collector).
otelcol.receiver.otlp "apps" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		metrics = [otelcol.processor.batch.apps.input]
		logs    = [otelcol.processor.filter.loki_min_level.input]
		traces  = [otelcol.processor.batch.traces.input]
	}
}

// Drop logs below Alloy LOG_LEVEL before Loki (apps export debug; filter here). Restart alloy after LOG_LEVEL changes.
otelcol.processor.filter "loki_min_level" {
	error_mode = "ignore"

	logs {
		log_record = [
			"severity_number < " + coalesce(
				{
					"debug"   = "SEVERITY_NUMBER_DEBUG",
					"DEBUG"   = "SEVERITY_NUMBER_DEBUG",
					"info"    = "SEVERITY_NUMBER_INFO",
					"INFO"    = "SEVERITY_NUMBER_INFO",
					"warn"    = "SEVERITY_NUMBER_WARN",
					"WARN"    = "SEVERITY_NUMBER_WARN",
					"warning" = "SEVERITY_NUMBER_WARN",
					"WARNING" = "SEVERITY_NUMBER_WARN",
					"error"   = "SEVERITY_NUMBER_ERROR",
					"ERROR"   = "SEVERITY_NUMBER_ERROR",
				}[coalesce(env("LOG_LEVEL"), "info")],
				"SEVERITY_NUMBER_INFO",
			),
		]
	}

	output {
		logs = [otelcol.processor.batch.logs.input]
	}
}

otelcol.processor.batch "apps" {
	output {
		metrics = [otelcol.exporter.prometheus.apps.input]
	}
}

// Accept OTLP logs (Go services) → Loki native OTLP (/otlp). Log line = message; zap fields = structured metadata.
otelcol.processor.batch "logs" {
	output {
		logs = [otelcol.exporter.otlphttp.loki.input]
	}
}

otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = "http://loki:3100/otlp"
		tls {
			insecure = true
		}
	}
}

// Accept OTLP traces then discard — app traces go to Sentry, not Alloy.
otelcol.processor.batch "traces" {
	output {
		traces = [otelcol.exporter.debug.discard_traces.input]
	}
}

otelcol.exporter.debug "discard_traces" {
	verbosity           = "basic"
	sampling_initial    = 0
	sampling_thereafter = 0
}

// Match otel-collector translation_strategy UnderscoreEscapingWithoutSuffixes (no extra type/unit suffixes).
otelcol.exporter.prometheus "apps" {
	add_metric_suffixes     = false
	include_scope_info      = false
	include_target_info     = false
	include_scope_labels    = false
	resource_to_telemetry_conversion = false
	forward_to              = [prometheus.relabel.otel_collector.receiver]
}

// Prometheus scrape used job="otel_collector"; preserve that label for dashboards that filter on it.
prometheus.relabel "otel_collector" {
	forward_to = [prometheus.remote_write.local.receiver]

	rule {
		action       = "replace"
		target_label = "job"
		replacement  = "otel_collector"
	}
}

prometheus.remote_write "local" {
	endpoint {
		url = "http://prometheus:9090/api/v1/write"
	}
}
